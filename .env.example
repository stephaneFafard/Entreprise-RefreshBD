# Serveur web de l'application
PORT=3100

# MariaDB locale
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
# Outils mysql / mysqldump de la MariaDB locale
LOCAL_MYSQL_BIN=C:\xampp\mysql\bin

# Serveur de production (cPanel) — connexion SSH
SSH_HOST=
SSH_PORT=22
SSH_USER=
# Authentification : clé privée (recommandé) OU mot de passe
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
SSH_PASSWORD=
# Empreinte du serveur (ex. SHA256:abc...) — affichée dans la console à la 1re connexion
SSH_HOST_FINGERPRINT=

# MySQL de production (par défaut : utilisateur et mot de passe cPanel)
PROD_DB_USER=
PROD_DB_PASSWORD=
# Préfixe cPanel des bases (ex. moncompte_) ajouté au nom local s'il ne l'a pas déjà
PROD_DB_PREFIX=

# Correspondances quand le nom local diffère du nom en production (majuscules ignorées)
# Format : base_locale:base_prod,autre_locale:autre_prod
PROD_DB_MAP=

# Nombre de sauvegardes locales conservées par base (dans data/backups)
BACKUP_KEEP=3
